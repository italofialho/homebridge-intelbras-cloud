{
  "name": "homebridge-intelbras-cloud",
  "version": "0.1.0-beta.7",
  "description": "Intelbras DVR cameras over T2U Cloud CONNECT or LAN",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "keywords": [
    "homebridge-plugin",
    "intelbras",
    "camera",
    "hksv"
  ],
  "engines": {
    "node": ">=22",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.cjs",
    "prepack": "npm run build",
    "pack:local": "npm test && npm pack --pack-destination ../dist",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^1.0.3",
    "ffmpeg-for-homebridge": "^2.2.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/proper-lockfile": "^4.1.4",
    "homebridge": "^2.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/italofialho/homebridge-intelbras-cloud.git"
  },
  "homepage": "https://github.com/italofialho/homebridge-intelbras-cloud#readme",
  "bugs": {
    "url": "https://github.com/italofialho/homebridge-intelbras-cloud/issues"
